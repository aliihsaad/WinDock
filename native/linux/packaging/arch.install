post_install() {
    udevadm control --reload-rules 2>/dev/null || true
    modprobe uinput 2>/dev/null || true
    udevadm trigger --subsystem-match=misc --sysname-match=uinput 2>/dev/null || true
    /usr/lib/tara/user-service restart
    echo "Open Tara from your Hyprland application menu. It keeps running in the background after you close its window."
    echo "Run tara network for connection and firewall checks. No firewall rules were changed."
}
post_upgrade() {
    post_install
    echo "If an older Tara window is still open, close it and open Tara again. Your settings are kept."
}
pre_remove() {
    /usr/lib/tara/user-service stop
}
post_remove() {
    udevadm control --reload-rules 2>/dev/null || true
}
