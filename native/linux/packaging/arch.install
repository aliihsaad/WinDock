post_install() {
    udevadm control --reload-rules 2>/dev/null || true
    modprobe uinput 2>/dev/null || true
    udevadm trigger --subsystem-match=misc --sysname-match=uinput 2>/dev/null || true
    echo "Open WinDock from your Hyprland application menu. Keep its connection window open."
}
post_upgrade() {
    post_install
    echo "Restart WinDock to use the update. Your settings are kept."
}
post_remove() {
    udevadm control --reload-rules 2>/dev/null || true
}
