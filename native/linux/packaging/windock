#!/bin/sh
set -eu
if [ "$(id -u)" -eq 0 ]; then
    echo "Open WinDock from your desktop as a normal user, without sudo." >&2
    exit 1
fi
if [ "${1:-}" = "--version" ]; then
    exec /usr/lib/windock/node -p "'WinDock ' + require('/usr/lib/windock/package.json').version"
fi
# Starts the background host (windock.service) and shows its address and PIN.
exec /usr/lib/windock/node /usr/lib/windock/src/platform/linux-cli.js "$@"
